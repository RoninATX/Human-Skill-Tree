        "image": "static/images/skills/skill_default.png",
        "proficiency": {
          "level": 0,
          "scale": [
            "novice",
            "beginner",
            "competent",
            "proficient",
            "expert",
            "master"
          ],
          "levels": [
            {
              "name": "Novice",
              "capability": "Finds answers to factual questions using a search engine; distinguishes a primary source from an aggregator when pointed out."
            },
            {
              "name": "Beginner",
              "capability": "Triangulates a claim across 2-3 independent sources; recognizes obvious bias; documents where a fact came from."
            },
            {
              "name": "Competent",
              "capability": "Structures an open-ended question into sub-questions; produces a sourced brief on an unfamiliar topic that a decision-maker can act on."
            },
            {
              "name": "Proficient",
              "capability": "Identifies what is NOT known and why; weighs source quality systematically; surfaces disconfirming evidence others missed."
            },
            {
              "name": "Expert",
              "capability": "Conducts novel synthesis across domains; work is cited or relied on by other researchers; designs research methodologies for hard questions."
            },
            {
              "name": "Master",
              "capability": "Creates new knowledge or frameworks a field adopts; trains other researchers; sets standards for evidence and rigor."
            }
          ]
        },
