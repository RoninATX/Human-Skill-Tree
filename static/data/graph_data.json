        "id": "bjj",
        "label": "Jiu-Jitsu",
        "type": "skill",
        "domain": "physical",
        "category": "martial-arts",
        "description": "Ground-based grappling martial art",
        "image": "static/images/skills/skill_default.png",
        "proficiency": {
          "level": 0,
          "scale": [
            "novice",
            "beginner",
            "competent",
            "proficient",
            "expert",
            "master"
          ],
          "levels": [
            {
              "name": "White Belt",
              "capability": "Survives and escapes bad positions; knows fundamental movements (shrimping, bridging, breakfalls) and basic positional hierarchy."
            },
            {
              "name": "Blue Belt",
              "capability": "Chains 2-3 techniques from each major position; escapes side control and mount reliably against resisting training partners."
            },
            {
              "name": "Purple Belt",
              "capability": "Imposes a personal game plan against resisting peers; has a developed guard and at least one reliable submission series."
            },
            {
              "name": "Brown Belt",
              "capability": "Adapts strategy mid-roll against unfamiliar styles; teaches fundamentals to beginners; competes or performs at a high recreational level."
            },
            {
              "name": "Black Belt",
              "capability": "Innovates or refines techniques; consistently controls skilled opponents; recognized as an authority who develops other practitioners."
            },
            {
              "name": "Master",
              "capability": "Shapes the art itself - develops positions or systems others adopt; black belts seek out their instruction."
            }
          ]
        },
        "tags": [
          "combat",
          "grappling"
        ]
