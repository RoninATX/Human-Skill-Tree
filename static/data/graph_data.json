            {
              "name": "Proficient",
              "capability": "Navigates accurately at night or in poor visibility; completes point-to-point routes in unfamiliar terrain within tight tolerances."
            },
            {
              "name": "Expert",
              "capability": "Leads groups through featureless or hostile terrain; teaches navigation; integrates celestial and improvised methods when equipment fails."
            },
